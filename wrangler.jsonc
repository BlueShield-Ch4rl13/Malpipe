// Despliegue del portal en Cloudflare (Workers con recursos estaticos), igual
// que cti. y dfir. Solo sirve ficheros: no hay codigo de servidor.
//
// En Cloudflare: Workers y Pages > Crear > Importar un repositorio > Malpipe
//   Comando de compilacion:  npm ci && npm run build
//   Comando de despliegue:   npx wrangler deploy
// Despues, en el Worker: Configuracion > Dominios y rutas > box.carlosvillalbalagos.com
{
  "name": "malpipe-box",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./web/dist",
    "not_found_handling": "404-page"
  }
}
