// box.carlosvillalbalagos.com en Cloudflare Workers (el Worker "malpipe").
// Publica la raiz del repositorio tal cual, como dfir.: index.html y motor/ ya
// estan hechos, no hay paso de compilacion ni codigo de servidor. _headers (CSP
// y cache) y 404.html se aplican igual que en Pages; .assetsignore deja fuera el
// proyecto Python.
//
// En el Worker, Configuracion > Compilacion:
//   Comando de compilacion:  (vacio)
//   Comando de despliegue:   npx wrangler deploy
// Despues, Configuracion > Dominios y rutas > box.carlosvillalbalagos.com
{
  "name": "malpipe",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": ".",
    "not_found_handling": "404-page"
  },
  // Sin URL de vista previa por cada rama o PR: solo existe lo publicado
  "preview_urls": false
}
