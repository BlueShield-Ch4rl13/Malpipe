# Nada de esto debe acabar dentro de la imagen:
#  - .env lleva las claves de API (tria.ge, Turnstile)
#  - samples/ puede tener malware real
#  - reports/ son informes de muestras de terceros
.env
.env.*
!.env.example
samples/
reports/
.git/
.github/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/
# El portal estático (box/, ~18 MB de WebAssembly) y Node no hacen falta en la imagen
box/
node_modules/
scripts/
