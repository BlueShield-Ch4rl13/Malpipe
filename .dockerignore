# Nada de esto debe acabar dentro de la imagen:
#  - .env lleva las claves de API (tria.ge, Turnstile)
#  - samples/ puede tener malware real
#  - reports/ son informes de muestras de terceros
.env
.env.*
!.env.example
samples/
reports/
.git/
.github/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/
# El portal estático (~18 MB de WebAssembly) y Node no hacen falta en la imagen
motor/
index.html
404.html
estilo.css
app.js
motor.js
favicon.svg
_headers
.assetsignore
wrangler.jsonc
node_modules/
scripts/
