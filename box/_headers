# Cabeceras de box.carlosvillalbalagos.com (Cloudflare Pages sirve box/ tal cual, como dfir.)
#
# 'wasm-unsafe-eval' es lo minimo que necesitan Pyodide y YARA-X para compilar
# su WebAssembly; no habilita eval() de JavaScript. connect-src solo deja hablar
# con el propio portal y con el feed de News CTI.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; connect-src 'self' https://raw.githubusercontent.com; style-src 'self'; img-src 'self' data:; font-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), usb=(), payment=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Pyodide y YARA-X van en carpetas con su version: no cambian nunca
/pyodide-*
  Cache-Control: public, max-age=31536000, immutable
/yara-x-*
  Cache-Control: public, max-age=31536000, immutable
