# Copia este fichero a .env y rellena los valores. .env está en .gitignore.
# Todas las variables son opcionales: sin clave de sandbox el pipeline ejecuta solo estático.

# --- Sandbox dinámico (tria.ge; es el único implementado) ---
TRIAGE_API_KEY=          # Clave de API de tria.ge — habilita el análisis dinámico en la CLI
TRIAGE_BASE_URL=         # URL base de tria.ge (por defecto https://tria.ge/api/v0)

# --- Comportamiento del pipeline ---
MALPIPE_DYNAMIC_TIMEOUT= # Segundos de espera del informe del sandbox (300 por defecto)
MALPIPE_YARA_DIR=        # Carpeta de reglas YARA (rules/ por defecto)
MALPIPE_MAX_STRINGS=     # Nº máximo de strings interesantes en el informe (40 por defecto)

# --- Portal web ---
MALPIPE_MAX_UPLOAD_MB=   # Límite de tamaño de subida en MB (30 por defecto)
MALPIPE_RATE_MAX=        # Análisis máximos por ventana e IP (5 por defecto)
MALPIPE_RATE_WINDOW=     # Ventana del rate-limit en segundos (600 por defecto)
TURNSTILE_SITEKEY=       # Cloudflare Turnstile — sitekey pública (anti-bots)
TURNSTILE_SECRET=        # Cloudflare Turnstile — secreto del servidor
MALPIPE_WEB_DYNAMIC=0    # 1 = el portal manda las subidas a tria.ge con TU cuenta (públicas en el plan gratuito)
MALPIPE_BEHIND_CLOUDFLARE=0  # 1 = creer CF-Connecting-IP (solo si las conexiones llegan por Cloudflare Tunnel)
